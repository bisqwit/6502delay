; delay_n, delays n cycles with small code
; Will clobber A, and Z+N
; Will preserve X, Y, S, C, D, V, and I (interrupt-disable flag)
;
; Requires a dummy interrupt handler that does nothing but RTI.
;
; Requires that a label @nearby_rts is defined,
; that points _somewhere_ that contains a $60 byte (RTS).
;
; Requires that a label @nearby_rts_14cyc is defined,
; that points _somewhere_ that contains a dummy 2-cycle
; opcode, such as NOP or LDA #1, followed by a $60 byte (RTS).
;
; Requires that a label @nearby_rts_15cyc is defined,
; that points _somewhere_ that contains a JMP to a location that does RTS.
;
; Generated code is:
; -97 bytes or less when n <= 620
; -193 bytes or less when n <= 1244
; -289 bytes or less when n <= 1868
; -385 bytes or less when n <= 2492
; -482 bytes or less when n <= 3124
; -578 bytes or less when n <= 3748
; -674 bytes or less when n <= 4372
; -770 bytes or less when n <= 4996
; -866 bytes or less when n <= 5620
; -963 bytes or less when n <= 6249
; -1059 bytes or less when n <= 6873
; -1155 bytes or less when n <= 7497
; -1251 bytes or less when n <= 8121
; -1348 bytes or less when n <= 8753
; -1444 bytes or less when n <= 9377
; -1540 bytes or less when n <= 10001
; -1636 bytes or less when n <= 10625
; -1732 bytes or less when n <= 11249
; -1829 bytes or less when n <= 11878
; -1925 bytes or less when n <= 12502
; -2021 bytes or less when n <= 13126
; -2117 bytes or less when n <= 13750
; -2214 bytes or less when n <= 14382
; -2310 bytes or less when n <= 15006
; -2406 bytes or less when n <= 15630
; -2502 bytes or less when n <= 16254
; -2598 bytes or less when n <= 16878
; -2695 bytes or less when n <= 17507
; -2791 bytes or less when n <= 18131
; -2887 bytes or less when n <= 18755
; -2983 bytes or less when n <= 19379
; -3079 bytes or less when n <= 20000
; Detailed summary:
; - When 2 <= n <= 10: min=1, avg=2.7, max=4
; - When 11 <= n <= 20: min=2, avg=3.7, max=5
; - When 21 <= n <= 30: min=4, avg=5.3, max=6
; - When 31 <= n <= 50: min=6, avg=7.8, max=10
; - When 51 <= n <= 75: min=8, avg=11.1, max=14
; - When 76 <= n <= 100: min=12, avg=15.0, max=17
; - When 101 <= n <= 200: min=16, avg=24.6, max=33
; - When 201 <= n <= 300: min=32, avg=40.0, max=48
; - When 301 <= n <= 500: min=47, avg=63.1, max=79
; - When 501 <= n <= 750: min=78, avg=97.7, max=117
; - When 751 <= n <= 1000: min=116, avg=136.2, max=156
; - When 1001 <= n <= 2000: min=154, avg=232.3, max=310
; - When 2001 <= n <= 3000: min=308, avg=386.2, max=464
; - When 3001 <= n <= 5000: min=462, avg=616.9, max=771
; - When 5001 <= n <= 7500: min=770, avg=963.1, max=1156
; - When 7501 <= n <= 10000: min=1154, avg=1347.7, max=1540
; - When 10001 <= n <= 20000: min=1540, avg=2309.2, max=3079
; Written by Joel Yliluoma


.macro delay_n n, rest
.assert (n = 0 || n >= 2), error, "delay_n: delay must be 0 or >= 2"
.if(n = 0)
.elseif(n < 0)
	.error .sprintf("delay_n: n cannot be < 0, you gave %d", n)
.elseif(n > 20000)
	delay_n (n/2), { delay_n (n-(n/2)) }
.else
; 1 to 20000
