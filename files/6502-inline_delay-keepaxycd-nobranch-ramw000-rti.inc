; delay_n, delays n cycles with small code
; Will clobber Z+N, and V
; Will preserve A, X, Y, S, C, D, and I (interrupt-disable flag)
;
; WARNING: May write garbage into $00-$FF.
;
; Requires a dummy interrupt handler that does nothing but RTI.
;
; Requires that a label @nearby_rts is defined,
; that points _somewhere_ that contains a $60 byte (RTS).
;
; Requires that a label @nearby_rts_14cyc is defined,
; that points _somewhere_ that contains a dummy 2-cycle
; opcode, such as NOP or LDA #1, followed by a $60 byte (RTS).
;
; Requires that a label @nearby_rts_15cyc is defined,
; that points _somewhere_ that contains a JMP to a location that does RTS.

; Requires a disposable zeropage variable @zptemp.
;
; Generated code is:
; -97 bytes or less when n <= 620
; -193 bytes or less when n <= 1244
; -289 bytes or less when n <= 1868
; -385 bytes or less when n <= 2492
; -481 bytes or less when n <= 3116
; -578 bytes or less when n <= 3751
; -674 bytes or less when n <= 4375
; -770 bytes or less when n <= 4999
; -866 bytes or less when n <= 5623
; -962 bytes or less when n <= 6247
; -1059 bytes or less when n <= 6873
; -1155 bytes or less when n <= 7497
; -1251 bytes or less when n <= 8121
; -1347 bytes or less when n <= 8745
; -1443 bytes or less when n <= 9369
; -1539 bytes or less when n <= 9993
; -1636 bytes or less when n <= 10628
; -1732 bytes or less when n <= 11252
; -1828 bytes or less when n <= 11876
; -1924 bytes or less when n <= 12500
; -2020 bytes or less when n <= 13124
; -2117 bytes or less when n <= 13750
; -2213 bytes or less when n <= 14374
; -2309 bytes or less when n <= 14998
; -2405 bytes or less when n <= 15622
; -2501 bytes or less when n <= 16246
; -2598 bytes or less when n <= 16881
; -2694 bytes or less when n <= 17505
; -2790 bytes or less when n <= 18129
; -2886 bytes or less when n <= 18753
; -2982 bytes or less when n <= 19377
; -3078 bytes or less when n <= 20000
; Detailed summary:
; - When 2 <= n <= 10: min=1, avg=2.3, max=4
; - When 11 <= n <= 20: min=2, avg=3.5, max=4
; - When 21 <= n <= 30: min=4, avg=5.3, max=6
; - When 31 <= n <= 50: min=6, avg=7.7, max=10
; - When 51 <= n <= 75: min=8, avg=11.0, max=14
; - When 76 <= n <= 100: min=12, avg=14.8, max=17
; - When 101 <= n <= 200: min=16, avg=24.5, max=32
; - When 201 <= n <= 300: min=32, avg=39.9, max=48
; - When 301 <= n <= 500: min=47, avg=62.9, max=78
; - When 501 <= n <= 750: min=78, avg=97.5, max=117
; - When 751 <= n <= 1000: min=116, avg=136.0, max=156
; - When 1001 <= n <= 2000: min=154, avg=232.2, max=310
; - When 2001 <= n <= 3000: min=308, avg=386.0, max=464
; - When 3001 <= n <= 5000: min=462, avg=616.8, max=771
; - When 5001 <= n <= 7500: min=770, avg=962.9, max=1156
; - When 7501 <= n <= 10000: min=1154, avg=1347.5, max=1540
; - When 10001 <= n <= 20000: min=1540, avg=2309.1, max=3078
; Written by Joel Yliluoma


.macro delay_n n, rest
.assert (n = 0 || n >= 2), error, "delay_n: delay must be 0 or >= 2"
.if(n = 0)
.elseif(n < 0)
	.error .sprintf("delay_n: n cannot be < 0, you gave %d", n)
.elseif(n > 20000)
	delay_n (n/2), { delay_n (n-(n/2)) }
