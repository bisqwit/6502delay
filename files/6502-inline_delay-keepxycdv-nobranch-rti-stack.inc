; -1443 bytes or less when n <= 9377
; -1539 bytes or less when n <= 10001
; -1636 bytes or less when n <= 10629
; -1732 bytes or less when n <= 11253
; -1828 bytes or less when n <= 11877
; -1924 bytes or less when n <= 12501
; -2020 bytes or less when n <= 13125
; -2117 bytes or less when n <= 13758
; -2213 bytes or less when n <= 14382
; -2309 bytes or less when n <= 15006
; -2405 bytes or less when n <= 15630
; -2501 bytes or less when n <= 16254
; -2598 bytes or less when n <= 16882
; -2694 bytes or less when n <= 17506
; -2790 bytes or less when n <= 18130
; -2886 bytes or less when n <= 18754
; -2982 bytes or less when n <= 19378
; -3078 bytes or less when n <= 20000
; Detailed summary:
; - When 2 <= n <= 10: min=1, avg=1.9, max=3
; - When 11 <= n <= 20: min=2, avg=3.2, max=4
; - When 21 <= n <= 30: min=4, avg=4.8, max=5
; - When 31 <= n <= 50: min=6, avg=7.2, max=9
; - When 51 <= n <= 75: min=8, avg=10.6, max=13
; - When 76 <= n <= 100: min=12, avg=14.4, max=17
; - When 101 <= n <= 200: min=16, avg=24.1, max=32
; - When 201 <= n <= 300: min=32, avg=39.5, max=47
; - When 301 <= n <= 500: min=47, avg=62.5, max=78
; - When 501 <= n <= 750: min=78, avg=97.2, max=117
; - When 751 <= n <= 1000: min=116, avg=135.6, max=155
; - When 1001 <= n <= 2000: min=154, avg=231.8, max=309
; - When 2001 <= n <= 3000: min=308, avg=385.6, max=463
; - When 3001 <= n <= 5000: min=462, avg=616.4, max=770
; - When 5001 <= n <= 7500: min=770, avg=962.5, max=1155
; - When 7501 <= n <= 10000: min=1154, avg=1347.2, max=1539
; - When 10001 <= n <= 20000: min=1539, avg=2308.7, max=3078
; Written by Joel Yliluoma


.macro delay_n n, rest
.assert (n = 0 || n >= 2), error, "delay_n: delay must be 0 or >= 2"
